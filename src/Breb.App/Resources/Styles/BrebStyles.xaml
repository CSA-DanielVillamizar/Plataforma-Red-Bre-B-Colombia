<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ── Paleta Bre-B ─────────────────────────────────────────────── -->
    <Color x:Key="BrebPrimario">#512BD4</Color>
    <Color x:Key="BrebPrimarioClaro">#7C5CE6</Color>
    <Color x:Key="BrebAcento">#C77DFF</Color>
    <Color x:Key="BrebExito">#2E8B57</Color>
    <Color x:Key="BrebPeligro">#C0392B</Color>
    <Color x:Key="BrebBanco">#0A7EA4</Color>
    <Color x:Key="BrebFondo">#F4F2FB</Color>
    <Color x:Key="BrebTarjeta">#FFFFFF</Color>
    <Color x:Key="BrebTexto">#1C1340</Color>
    <Color x:Key="BrebTextoSuave">#6B6880</Color>

    <!-- Degradado para encabezados -->
    <LinearGradientBrush x:Key="BrebHeaderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#512BD4" Offset="0.0" />
        <GradientStop Color="#7C5CE6" Offset="1.0" />
    </LinearGradientBrush>

    <!-- ── Título grande de pantalla ────────────────────────────────── -->
    <Style x:Key="TituloPantalla" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- ── Etiqueta de campo ────────────────────────────────────────── -->
    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource BrebTextoSuave}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- ── Entry estilizado dentro de "marco" ───────────────────────── -->
    <Style x:Key="MarcoEntry" TargetType="Border">
        <Setter Property="Stroke" Value="#E3DEF5" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
    </Style>

    <!-- ── Botones ──────────────────────────────────────────────────── -->
    <Style x:Key="BotonPrimario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource BrebPrimario}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="BackgroundColor" Value="{StaticResource BrebExito}" />
    </Style>

    <Style x:Key="BotonAcento" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
        <Setter Property="BackgroundColor" Value="{StaticResource BrebAcento}" />
        <Setter Property="TextColor" Value="#2A1A4A" />
    </Style>

    <Style x:Key="BotonSecundario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource BrebPrimario}" />
        <Setter Property="BorderColor" Value="{StaticResource BrebPrimario}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
        <Setter Property="TextColor" Value="{StaticResource BrebPeligro}" />
        <Setter Property="BorderColor" Value="{StaticResource BrebPeligro}" />
    </Style>

    <!-- ── Tarjeta contenedora ──────────────────────────────────────── -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BrebTarjeta}" />
        <Setter Property="Stroke" Value="#ECE8F8" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="#512BD4" Offset="0,4" Radius="18" Opacity="0.12" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Chip de rol / badge ──────────────────────────────────────── -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#EDE7FB" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 20" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

</ResourceDictionary>
