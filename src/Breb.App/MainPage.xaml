<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Breb.App.ViewModels"
             x:DataType="vm:SaldoViewModel"
             x:Class="Breb.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="14">

            <Label
                Text="Bre-B · Cuenta"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>

            <Label
                Text="Para ver el saldo sirven luis.consulta y ana.operadora. Para transferir hace falta ana.operadora (rol operador)."
                FontSize="13"
                TextColor="Gray"
                LineBreakMode="WordWrap"/>

            <Label Text="Usuario"
                   FontSize="13"/>
            <Entry Text="{Binding Usuario}"
                   Placeholder="usuario"/>

            <Label Text="Clave"
                   FontSize="13"/>
            <Entry Text="{Binding Clave}"
                   IsPassword="True"
                   Placeholder="clave"/>

            <Button
                Text="Consultar saldo"
                Command="{Binding ConsultarSaldoCommand}"
                HorizontalOptions="Fill"/>

            <Label Text="Saldo disponible"
                   FontSize="13"
                   TextColor="Gray"/>
            <Label Text="{Binding SaldoTexto}"
                   FontSize="34"
                   FontAttributes="Bold"/>

            <Label Text="Saldo retenido"
                   FontSize="13"
                   TextColor="Gray"/>
            <Label Text="{Binding SaldoRetenidoTexto}"
                   FontSize="20"/>

            <BoxView HeightRequest="1"
                     BackgroundColor="LightGray"
                     Margin="0,8"/>

            <Label
                Text="Transferir desde esta cuenta"
                FontSize="18"
                FontAttributes="Bold"/>

            <Label Text="Monto en UVB"
                   FontSize="13"/>
            <Entry Text="{Binding MontoTexto}"
                   Keyboard="Numeric"
                   Placeholder="10"/>

            <Button
                Text="Transferir"
                Command="{Binding TransferirCommand}"
                HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding Cargando}"
                               IsVisible="{Binding Cargando}"/>

            <Label Text="{Binding ResultadoTransferencia}"
                   IsVisible="{Binding HayResultado}"
                   FontSize="15"
                   LineBreakMode="WordWrap"/>

            <Label Text="{Binding Estado}"
                   FontSize="14"
                   TextColor="Gray"
                   LineBreakMode="WordWrap">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="error">
                        <Setter Property="TextColor" Value="#B00020"/>
                        <Setter Property="FontAttributes" Value="Bold"/>
                    </DataTrigger>
                    <DataTrigger TargetType="Label" Binding="{Binding Tono}" Value="ok">
                        <Setter Property="TextColor" Value="#1B5E20"/>
                    </DataTrigger>
                </Label.Triggers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
