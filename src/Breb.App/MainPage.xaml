<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Breb.App.ViewModels"
             x:DataType="vm:SaldoViewModel"
             x:Class="Breb.App.MainPage"
             Title="Saldo">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="18">

            <Label Text="{Binding SesionTexto}"
                    FontSize="13"
                    TextColor="Gray"/>

            <Label Text="Cuenta"
                    FontSize="13"/>
            <Entry Text="{Binding CuentaId}"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"/>

            <Button
                Text="Consultar saldo"
                Command="{Binding ConsultarSaldoCommand}"
                HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding Cargando}"
                    IsVisible="{Binding Cargando}"/>

            <BoxView HeightRequest="1"
                    BackgroundColor="LightGray"
                    Margin="0,10"/>

            <Label Text="Saldo disponible"
                    FontSize="13"
                    TextColor="Gray"/>
            <Label Text="{Binding SaldoDisponible}"
                    FontSize="34"
                    FontAttributes="Bold"/>

            <Label Text="Saldo retenido"
                    FontSize="13"
                    TextColor="Gray"/>
            <Label Text="{Binding SaldoRetenido}"
                    FontSize="20"/>

            <Label Text="{Binding Estado}"
                    FontSize="13"
                    TextColor="Gray"
                    LineBreakMode="WordWrap"/>

            <Button Text="Cerrar sesión"
                    Command="{Binding CerrarSesionCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
