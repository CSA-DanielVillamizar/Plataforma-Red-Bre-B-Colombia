<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Breb.App.ViewModels"
             x:DataType="vm:SaldoViewModel"
             x:Class="Breb.App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="18">

            <Label
                Text="Bre-B · Saldo de la cuenta"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1"/>

            <!--
                Clase 19: aquí ya no hay usuario ni clave. El token lo trajo
                la pantalla de entrada; esta pantalla sólo muestra quién
                entró, para que en la demo se vea que es UNA sesión y no un
                login por pantalla.
            -->
            <Label Text="Sesión" FontSize="11" TextColor="Gray"/>
            <Label Text="{Binding QuienEntro}" FontSize="15" FontAttributes="Bold"/>

            <Button
                Text="Consultar saldo"
                Command="{Binding ConsultarSaldoCommand}"
                HorizontalOptions="Fill"/>

            <ActivityIndicator IsRunning="{Binding Cargando}"
                    IsVisible="{Binding Cargando}"/>

            <BoxView HeightRequest="1"
                    BackgroundColor="LightGray"
                    Margin="0,10"/>

            <Label Text="Saldo disponible"
                    FontSize="13"
                    TextColor="Gray"/>
            <Label Text="{Binding SaldoTexto}"
                    FontSize="34"
                    FontAttributes="Bold"/>

            <Label Text="{Binding Estado}"
                    FontSize="13"
                    TextColor="Gray"
                    LineBreakMode="WordWrap"/>

            <BoxView HeightRequest="1"
                    BackgroundColor="LightGray"
                    Margin="0,10"/>

            <Label Text="API" FontSize="11" TextColor="Gray"/>
            <Label Text="{Binding DireccionApi}"
                   FontSize="12"
                   FontFamily="Monospace"
                   LineBreakMode="WordWrap"/>

            <Button Text="Cerrar sesión"
                    Command="{Binding SalirCommand}"
                    HorizontalOptions="Fill"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
