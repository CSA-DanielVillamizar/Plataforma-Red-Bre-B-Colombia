<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Breb.App.ViewModels"
             x:Class="Breb.App.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="Red Bre-B"
                   Style="{StaticResource Headline}"
                   HorizontalOptions="Center" />
            <Label Text="Inicie sesión para obtener el JWT"
                   Style="{StaticResource SubHeadline}"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Usuario" Text="{Binding Usuario}" />
            <Entry Placeholder="Contraseña" Text="{Binding Clave}" IsPassword="True" />

            <Button Text="Entrar" Command="{Binding LoginCommand}" />

            <ActivityIndicator IsRunning="{Binding EstaCargando}"
                               IsVisible="{Binding EstaCargando}" />

            <Label Text="{Binding MensajeError}"
                   TextColor="DarkRed"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
