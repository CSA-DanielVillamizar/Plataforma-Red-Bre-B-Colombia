<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Breb.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    FlyoutBehavior="Disabled"
    Title="Bre-B">

    <TabBar>
        <Tab Title="Entrar">
            <ShellContent x:Name="ContenidoLogin" Route="login" Title="Entrar" />
        </Tab>
        <Tab Title="Saldo">
            <ShellContent x:Name="ContenidoSaldo" Route="saldo" Title="Saldo" />
        </Tab>
        <Tab Title="Transferir">
            <ShellContent x:Name="ContenidoTransferencia" Route="transferencia" Title="Transferir" />
        </Tab>
    </TabBar>

</Shell>
