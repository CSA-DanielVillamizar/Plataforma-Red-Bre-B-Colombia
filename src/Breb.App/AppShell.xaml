<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Breb.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pantallas="clr-namespace:Breb.App.Pantallas"
    FlyoutBehavior="Disabled"
    Title="Bre-B · Squad Datos">

    <ShellContent
        Title="Inicio de sesión"
        Route="login"
        ContentTemplate="{DataTemplate pantallas:InicioSesionPage}" />

    <TabBar Route="principal">
        <ShellContent
            Title="Saldo"
            Route="saldo"
            ContentTemplate="{DataTemplate pantallas:SaldoPage}" />
        <ShellContent
            Title="Transferir"
            Route="transferir"
            ContentTemplate="{DataTemplate pantallas:TransferenciaPage}" />
    </TabBar>

</Shell>
