<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Breb.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Breb.App"
    Title="Breb.App">

    <!--
        Clase 18: dos pantallas. El TabBar da la navegación sin escribir
        código, y cada plataforma aplica su propia convención: en Android
        las pestañas quedan abajo, en Windows arriba. No hay que decidirlo
        ni detectar el aparato.
    -->
    <TabBar>
        <ShellContent
            Title="Saldo"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Transferir"
            ContentTemplate="{DataTemplate local:TransferenciaPage}"
            Route="TransferenciaPage" />
    </TabBar>

</Shell>
