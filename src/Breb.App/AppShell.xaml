<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Breb.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Breb.App"
    xmlns:vistas="clr-namespace:Breb.App.Vistas"
    Title="Breb.App">

    <!-- Pantalla 1: arranca aquí. Sin pestañas hasta tener token. -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate vistas:LoginPage}" />

    <!-- Pantallas 2 y 3, después del login. -->
    <TabBar Route="app">
        <ShellContent
            Title="Saldo"
            Route="saldo"
            ContentTemplate="{DataTemplate local:MainPage}" />
        <ShellContent
            Title="Transferir"
            Route="transferir"
            ContentTemplate="{DataTemplate vistas:TransferenciaPage}" />
    </TabBar>

</Shell>
